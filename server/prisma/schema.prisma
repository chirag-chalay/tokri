generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  staff
  admin
  super_admin
}

enum CouponType {
  percent
  flat
}

enum OrderStatus {
  pending
  paid
  packed
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMode {
  online
  cod
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  username            String?              @unique
  email               String?              @unique
  password            String?
  role                UserRole             @default(staff)
  isActive            Boolean              @default(true)
  permissions         AdminPermission?
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Customer {
  id          String        @id @default(cuid())
  name        String?
  phone       String        @unique
  dateOfBirth DateTime?     @db.Date
  addresses   Json?
  isActive    Boolean       @default(true)
  orders      Order[]
  cart        Cart?
  devices     DeviceToken[]
  couponUses  CouponRedemption[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AdminPermission {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manageProducts Boolean @default(false)
  manageCatalog  Boolean @default(false)
  manageMedia    Boolean @default(false)
  manageOrders   Boolean @default(false)
  manageCoupons  Boolean @default(false)
  manageContent  Boolean @default(false)
  manageSettings Boolean @default(false)
  manageUsers    Boolean @default(false)
}

model Category {
  id          String            @id @default(cuid())
  slug        String            @unique
  label       String
  title       String?
  subtitle    String?           @db.Text
  description String?           @db.Text
  image               String?
  bannerImage         String?
  sortOrder           Int               @default(0)
  productDisplayLimit Int               @default(12)
  isActive            Boolean           @default(true)
  products            Product[]
  productLinks        ProductCategory[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Product {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String
  description   String?           @db.Text
  priceValue    Decimal           @db.Decimal(10, 2)
  oldPriceValue Decimal?          @db.Decimal(10, 2)
  currency      String            @default("INR")
  weight        String?
  image         String?
  mediaId       String?
  media         Media?            @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryLinks ProductCategory[]
  badge         String?
  isBestSeller  Boolean           @default(false)
  isImported    Boolean           @default(false)
  isFeatured    Boolean           @default(false)
  stock         Int               @default(100)
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  hsnCode       String?           @default("0808")
  gstRate       Decimal           @default(0.00) @db.Decimal(5, 2)
  isTaxable     Boolean           @default(false)
  taxInfo       ProductTax?
  reviews       Review[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([categoryId])
  @@index([isBestSeller])
  @@index([isImported])
  @@index([isActive])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Media {
  id           String    @id @default(cuid())
  filename     String
  originalName String
  path         String    @unique
  folder       String    @default("general")
  mimeType     String
  size         Int
  products     Product[]
  createdAt    DateTime  @default(now())
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType @default(percent)
  value        Decimal    @db.Decimal(10, 2)
  minCart      Decimal?   @db.Decimal(10, 2)
  maxDiscount  Decimal?   @db.Decimal(10, 2)
  applyOn      String     @default("cart")
  targetType   String     @default("all")
  targetSlugs  Json?
  usageType    String     @default("unlimited")
  startsAt     DateTime?
  expiresAt    DateTime?
  usageLimit   Int?
  usedCount    Int        @default(0)
  isActive     Boolean    @default(true)
  redemptions  CouponRedemption[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([couponId, customerId])
  @@index([customerId])
}

model Order {
  id                     String           @id @default(cuid())
  orderNo                String           @unique
  customerId             String?
  customer               Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status                 OrderStatus      @default(pending)
  paymentStatus          PaymentStatus    @default(pending)
  paymentMode            PaymentMode      @default(cod)
  paymentCollectedAs     String?
  itemsTotal             Decimal          @db.Decimal(10, 2)
  deliveryCharge         Decimal          @db.Decimal(10, 2) @default(25)
  handlingCharge         Decimal          @db.Decimal(10, 2) @default(2)
  smallCartCharge        Decimal          @db.Decimal(10, 2) @default(0)
  discount               Decimal          @db.Decimal(10, 2) @default(0)
  taxTotal               Decimal          @db.Decimal(10, 2) @default(0)
  cgstTotal              Decimal          @db.Decimal(10, 2) @default(0)
  sgstTotal              Decimal          @db.Decimal(10, 2) @default(0)
  igstTotal              Decimal          @db.Decimal(10, 2) @default(0)
  isInterState           Boolean          @default(false)
  grandTotal             Decimal          @db.Decimal(10, 2)
  couponCode             String?
  deliveryOption         String?
  expectedDeliveryDate   DateTime?        @db.Date
  freeDeliveryApplied    Boolean          @default(false)
  address                Json?
  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpayPaymentLinkId  String?
  razorpayQrUrl          String?          @db.Text
  deliveryPartnerId      String?
  deliveryPartner        DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  deliveryPartnerName    String?
  deliveryPartnerPhone   String?
  deliveryPincode        String?
  deliveryAssignedAt     DateTime?
  items                  OrderItem[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([deliveryPartnerId])
  @@index([deliveryPincode])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name       String
  priceValue Decimal  @db.Decimal(10, 2)
  quantity   Int
  image      String?
  weight     String?
  hsnCode    String?  @default("0808")
  isTaxable  Boolean  @default(false)
  gstRate    Decimal  @default(0.00) @db.Decimal(5, 2)
  taxAmount  Decimal  @default(0.00) @db.Decimal(10, 2)
  cgstAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  sgstAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  igstAmount Decimal  @default(0.00) @db.Decimal(10, 2)
}

model Review {
  id         String   @id @default(cuid())
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title      String
  content    String   @db.Text
  name       String
  image      String?
  rating     Int      @default(5)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String?  @db.LongText
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  body        String?   @db.LongText
  coverImage  String?   @db.Text
  author      String?   @default("Tokriii")
  category    String?
  isPublished Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model Setting {
  id                        Int      @id @default(1)
  storeName                 String?  @default("Tokriii")
  storeTagline              String?
  storeEmail                String?
  storePhone1               String?
  storePhone2               String?
  storeAddress              String?  @db.Text
  promoBanner               String?  @db.Text
  earlyDelivery             String?
  shippingFee               Decimal  @default(25) @db.Decimal(10, 2)
  handlingFee               Decimal  @default(2) @db.Decimal(10, 2)
  morningDeliveryTitle      String?  @default("Flawless Morning Delivery")
  morningDeliverySubtitle   String?  @default("Freshness Guaranteed")
  morningShippingFee        Decimal  @default(25) @db.Decimal(10, 2)
  morningFreeAbove          Decimal  @default(0) @db.Decimal(10, 2)
  expressDeliveryTitle      String?  @default("Same day")
  expressDeliverySubtitle   String?  @default("On-Demand Luxury")
  expressShippingFee        Decimal  @default(99) @db.Decimal(10, 2)
  expressFreeAbove          Decimal  @default(0) @db.Decimal(10, 2)
  expressMinimumOrderValue  Decimal  @default(1251) @db.Decimal(10, 2)
  firstThreeMorningEnabled  Boolean  @default(true)
  homeBannerImage           String?  @db.Text
  homeMobileBannerImage     String?  @db.Text
  homeHighlightImage        String?  @db.Text
  homeFeaturedCategorySlugs String?  @db.Text
  razorpayEnabled           Boolean  @default(false)
  razorpayKeyId             String?
  razorpayKeySecret         String?
  codEnabled                Boolean  @default(true)
  msg91Enabled              Boolean  @default(false)
  msg91AuthKey              String?
  msg91SenderId             String?
  msg91OtpTemplateId        String?
  msg91OrderTemplateId      String?
  msg91WhatsappEnabled           Boolean  @default(false)
  msg91WhatsappNumber            String?
  msg91WhatsappNamespace         String?
  msg91WhatsappLanguage          String?  @default("en")
  msg91WhatsappOtpEnabled        Boolean  @default(true)
  msg91WhatsappOtpTemplate       String?
  msg91WhatsappOtpButton         Boolean  @default(false)
  msg91WhatsappOrderEnabled      Boolean  @default(true)
  msg91WhatsappOrderTemplate     String?
  msg91WhatsappPartnerEnabled    Boolean  @default(true)
  msg91WhatsappPartnerTemplate   String?
  socialLinks               Json?
  store                     Json?
  theme                     Json?
  home                      Json?
  payment                   Json?
  messaging                 Json?
  updatedAt                 DateTime @updatedAt
}

model AppReleasePolicy {
  platform           String   @id
  enabled            Boolean  @default(false)
  latestBuild        Int      @default(0)
  minimumBuild       Int      @default(0)
  blockedBuilds      String?  @db.Text
  title              String?  @default("Update Tokriii")
  message            String?  @db.Text
  remindAfterHours   Int      @default(24)
  maintenance        Boolean  @default(false)
  maintenanceTitle   String?  @default("Tokriii is paused")
  maintenanceMessage String?  @db.Text
  updatedAt          DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OtpRequest {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model DeviceToken {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  provider   String   @default("expo")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model DeliveryPartner {
  id                  String                  @id @default(cuid())
  name                String
  email               String                  @unique
  phone               String                  @unique
  password            String?
  dateOfBirth         DateTime?
  fatherName          String?
  panNumber           String?
  aadhaarNumber       String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  pincode             String?
  permanentAddress    String?                 @db.Text
  emergencyName       String?
  emergencyPhone      String?
  vehicleType         String?
  vehicleNumber       String?
  accountHolderName   String?
  accountNumber       String?
  ifscCode            String?
  isActive            Boolean                 @default(false)
  notes               String?                 @db.Text
  pincodes            ServiceablePincode[]
  orders              Order[]
  devices             PartnerDeviceToken[]
  passwordTokens      PartnerPasswordToken[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model ServiceablePincode {
  id               String           @id @default(cuid())
  pincode          String           @unique
  areaLabel        String?
  city             String?
  stateCode        String?
  state            IndiaState?      @relation(fields: [stateCode], references: [code], onDelete: SetNull)
  isActive         Boolean          @default(true)
  morningEnabled   Boolean          @default(true)
  expressEnabled   Boolean          @default(false)
  partnerId        String?
  partner          DeliveryPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([partnerId])
  @@index([stateCode])
}

model IndiaState {
  code     String               @id
  name     String
  pincodes ServiceablePincode[]
}

model PartnerPasswordToken {
  id        String          @id @default(cuid())
  partnerId String
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([partnerId])
}

model PartnerDeviceToken {
  id        String          @id @default(cuid())
  partnerId String
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  token     String          @unique
  platform  String
  provider  String          @default("expo")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([partnerId])
}

model ProductTax {
  id           String   @id @default(cuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName  String
  categoryName String?
  hsnCode      String   @default("0808")
  gstRate      Decimal  @default(0.00) @db.Decimal(5, 2)
  isTaxable    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
}
