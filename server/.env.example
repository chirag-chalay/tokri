# MySQL — URL-encode special chars in password (@ → %40)
DATABASE_URL="mysql://root:your_password@localhost:3306/tokri"

# Local backend process settings
PORT=5223
NODE_ENV=development

# Custom admin URL path
ADMIN_PATH=/tokri-backoffice

# Local storefront + admin browser URL
APP_URL=http://localhost:5222

CLIENT_URL=http://localhost:5222

API_URL=http://localhost:5223

# Public uploads origin, independent of API_URL. Leave empty to infer from CLIENT_URL.
# Production: https://tokriii.com; staging: https://server.tokriii.com
PUBLIC_ASSET_URL=

# Optional: proxy storefront HTML to a local Next.js process on the same public port.
# Leave empty to keep serving Vite dist/. Example for staging:
# TOKRIII_NEXT_ORIGIN=http://127.0.0.1:3000

# Optional extra CORS origins, comma-separated
# CORS_ORIGINS=https://www.tokriii.com,https://tokriii.com

# Set true when running behind Nginx/PM2 on production
TRUST_PROXY=false

# Admin panel login (change in production)
ADMIN_EMAIL=admin@tokriii.com
ADMIN_PASSWORD=admin123

# Session secret (generate a long random string for production)
SESSION_SECRET=change-me-to-a-long-random-string

# Customer JWT for website + mobile app (defaults to SESSION_SECRET if empty)
JWT_SECRET=change-me-to-a-long-random-string
# 30 days
JWT_EXPIRES_IN_SECONDS=2592000

# Email (for password reset). Leave SMTP_HOST empty to log emails to console in dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tokriii <noreply@tokriii.com>

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MSG91 SMS (admin Settings → Notifications overrides these values)
# Use the MSG91 Template ID from the copy icon, not the 19-digit Airtel DLT ID.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_ORDER_TEMPLATE_ID=

# MSG91 WhatsApp fallback. Used when SMS is off or the SMS gateway rejects a message.
# Templates are approved in MSG91 and take positional body variables:
# OTP template: 1 variable (the code). Order template: 3 (name, order number, amount)
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_OTP_TEMPLATE=
MSG91_WHATSAPP_ORDER_TEMPLATE=
MSG91_WHATSAPP_LANGUAGE=en
MSG91_WHATSAPP_NAMESPACE=

# --- Local development example ---
# PORT=5223
# NODE_ENV=development
# APP_URL=http://localhost:5222
# CLIENT_URL=http://localhost:5222
# API_URL=http://localhost:5223
# TRUST_PROXY=false

# Website tracking runtime configuration (disabled until configured).
TRACKING_ENABLED=false
TRACKING_ALLOWED_HOSTS=tokriii.com,www.tokriii.com
TRACKING_GTM_ENABLED=false
TRACKING_GTM_CONTAINER_ID=
TRACKING_GA4_MEASUREMENT_ID=
TRACKING_META_PIXEL_ENABLED=false
TRACKING_META_PIXEL_ID=
TRACKING_CURRENCY=INR
TRACKING_CONFIG_VERSION=1
# Private server-side CAPI configuration. Enable only after migration and verification.
META_CAPI_ENABLED=false
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=
META_CAPI_TEST_EVENT_CODE=

# Private monitoring storage. Keep outside uploads/static folders. One writer process per directory.
# LOG_DIRECTORY=/var/lib/tokri/logs
LOG_RETENTION_DAYS=30
LOG_MAX_MB=256
LOG_QUEUE_LIMIT=2000

# Critical payment/audit durability. Apply prisma/sql/monitoring-outbox.sql before rollout.
# Stable, unique alias per logical server/log volume; keep unchanged across process restarts.
LOG_OUTBOX_DESTINATION=tokri-server
LOG_OUTBOX_MAX_MB=64
LOG_OUTBOX_RETENTION_DAYS=7
LOG_OUTBOX_POLL_MS=2000
# Enabled by default; disabling removes durable recovery (used only by isolated unit tests).
LOG_OUTBOX_ENABLED=true

# Mobile Google Analytics runtime switch; false pauses SDK collection after config refresh.
MOBILE_ANALYTICS_ENABLED=true
