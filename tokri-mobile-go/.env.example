# Copy to .env for local Expo:
#   cp .env.example .env
#
# Staging (works without same Wi‑Fi / adb):
EXPO_PUBLIC_API_BASE_URL=https://server.tokriii.com/api/v1
#
# Local API via USB adb reverse:
#   adb reverse tcp:5223 tcp:5223
#   EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5223/api/v1
#
# Live (usually avoid for day-to-day Expo):
# EXPO_PUBLIC_API_BASE_URL=https://tokriii.com/api/v1
#
# EAS:
#   eas build --profile staging     → server.tokriii.com
#   eas build --profile production  → tokriii.com

# Mobile Meta SDK build configuration (integration is not enabled yet).
# App Secret and website CAPI tokens must never be placed in the mobile app.
META_APP_ID=
META_APP_DISPLAY_NAME=Tokriii
META_CLIENT_TOKEN=

# Set false for a Google-only build; native configuration changes require rebuilding.
META_ENABLED=true

# Production India release: opt_out starts Google/Meta automatically for new users.
# Explicit refusals and iOS ATT are respected. Set opt_in to require app agreement.
TRACKING_DEFAULT_MODE=opt_out
