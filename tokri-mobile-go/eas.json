{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://server.tokriii.com/api/v1"
      },
      "node": "24.12.0"
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://server.tokriii.com/api/v1"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "24.12.0"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tokriii.com/api/v1"
      },
      "node": "24.12.0"
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tokriii.com/api/v1"
      },
      "node": "24.12.0"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6822043083"
      }
    }
  }
}
